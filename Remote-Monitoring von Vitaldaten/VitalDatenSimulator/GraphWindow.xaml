<Window x:Class="VitalDatenSimulator.GraphWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VitalDatenSimulator"
        mc:Ignorable="d"
        Title="VitalParameter Graphs" 
        Height="600" Width="900">
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Live Vitalparameter Graph"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2b3e50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>

        <Border Grid.Row="1" Background="White" BorderBrush="#ccc" BorderThickness="1" CornerRadius="8">
            <Canvas x:Name="GraphCanvas"/>
        </Border>

    </Grid>
</Window>
