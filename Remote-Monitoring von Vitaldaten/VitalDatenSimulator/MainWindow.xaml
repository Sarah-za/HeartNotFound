<Window x:Class="VitalDatenSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VitalDatenSimulator"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="500" Width="450"
        Background="#f5f5f5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Vitaldaten Simulator"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2b3e50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>


        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,10">

            <TextBlock Text="{Binding StationID}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <StackPanel Margin="0,5">
                <TextBlock Text="Heart Rate (bpm)" FontWeight="Bold"/>
                <Slider Minimum="40" Maximum="180" Value="{Binding HeartRate, Mode=TwoWay}" TickFrequency="10" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding HeartRate, StringFormat='Heart Rate: {0} bpm'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Temperature (°C)" FontWeight="Bold"/>
                <Slider Minimum="34" Maximum="42" Value="{Binding Temperature, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding Temperature, StringFormat='Temperature: {0:F1} °C'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Blood Pressure (mmHg)" FontWeight="Bold"/>
                <Slider Minimum="60" Maximum="180" Value="{Binding BloodPressure, Mode=TwoWay}" TickFrequency="5" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding BloodPressure, StringFormat='Blood Pressure: {0} mmHg'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Respiratory Rate (breaths/min)" FontWeight="Bold"/>
                <Slider Minimum="8" Maximum="40" Value="{Binding RespRate, Mode=TwoWay}" TickFrequency="2" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding RespRate, StringFormat='Respiratory Rate: {0} breaths/min'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Oxygen Saturation (%)" FontWeight="Bold"/>
                <Slider Minimum="70" Maximum="100" Value="{Binding SpO2, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding SpO2, StringFormat='Oxygen Saturation: {0} %'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

        </StackPanel>

        <Button Grid.Row="2" Content="Show Current Values"
                Background="#2b3e50" Foreground="White"
                FontWeight="Bold" Padding="10"
                HorizontalAlignment="Center"
                Click="ShowValues" Margin="0,10,0,0"/>
    </Grid>
</Window>
