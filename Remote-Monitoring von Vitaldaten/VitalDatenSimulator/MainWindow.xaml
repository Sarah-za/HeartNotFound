<Window x:Class="VitalDatenSimulator.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:VitalDatenSimulator"
        mc:Ignorable="d"
        Title="MainWindow" 
        Height="940" Width="450"
        Background="#f5f5f5">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <TextBlock Text="Vitaldaten Simulator"
                   FontSize="24"
                   FontWeight="Bold"
                   Foreground="#2b3e50"
                   HorizontalAlignment="Center"
                   Margin="0,0,0,10"/>


        <StackPanel Grid.Row="1" Orientation="Vertical" Margin="0,10,0,10">

            <TextBlock Text="{Binding StationID}"
                       FontSize="16"
                       FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Margin="0,0,0,15"/>

            <StackPanel Margin="0,5">
                <TextBlock Text="Heart Rate (bpm)" FontWeight="Bold"/>
                <Slider Minimum="40" Maximum="160" Value="{Binding HeartRate, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding HeartRate, StringFormat='Heart Rate: {0:F1} bpm'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Temperature (°C)" FontWeight="Bold"/>
                <Slider Minimum="34" Maximum="42" Value="{Binding Temperature, Mode=TwoWay}" TickFrequency="0.1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding Temperature, StringFormat='Temperature: {0:F1} °C'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Blood Pressure (mmHg)" FontWeight="Bold"/>
                <Slider Minimum="70" Maximum="240" Value="{Binding BloodPressure, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding BloodPressure, StringFormat='Blood Pressure: {0:F1} mmHg'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Respiratory Rate (breaths/min)" FontWeight="Bold"/>
                <Slider Minimum="8" Maximum="30" Value="{Binding RespRate, Mode=TwoWay}" TickFrequency="1" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding RespRate, StringFormat='Respiratory Rate: {0:F1} breaths/min'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Oxygen Saturation (%)" FontWeight="Bold"/>
                <Slider Minimum="80" Maximum="99" Value="{Binding SpO2, Mode=TwoWay}" TickFrequency="0.5" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding SpO2, StringFormat='Oxygen Saturation: {0:F1} %'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <Separator Margin="0, 10"/>

            <TextBlock Text="Simulation Settings" FontWeight="Bold" FontSize="18" Margin="0,10,0,5" Foreground="#2b3e50"/>

            <StackPanel Margin="0,5">
                <TextBlock Text="Change Percent (%)" FontWeight="Bold"/>
                <Slider Minimum="0.25" Maximum="5" Value="{Binding ChangePercent, Mode=TwoWay}" TickFrequency="0.25" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding ChangePercent, StringFormat='Change Percent: {0} %'}" Foreground="#2b3e50" Margin="0,5"/>
            </StackPanel>

            <StackPanel Margin="0,5">
                <TextBlock Text="Update Interval (ms)" FontWeight="Bold"/>
                <Slider Minimum="100" Maximum="3000" Value="{Binding UpdateIntervall, Mode=TwoWay}" TickFrequency="100" IsSnapToTickEnabled="True"/>
                <TextBlock Text="{Binding UpdateIntervall, StringFormat='Update Interval: {0} ms'}" Foreground="#2b3e50" Margin="0,5"/>

            </StackPanel>

        </StackPanel>

        <StackPanel Grid.Row="3" Orientation="Vertical" HorizontalAlignment="Center" Margin="0,10,0,0">

            <Button Content="Start / Stop Simulation"
                        Background="#2b3e50" Foreground="White"
                        FontWeight="Bold" Padding="10" Width="200"
                        Click="ToggleSimulation" Margin="0,0,0,5"/>

            <Button Content="Show Current Values"
                        Background="#4a708b" Foreground="White"
                        FontWeight="Bold" Padding="10" Width="200"
                        Click="ShowValues" Margin="0,0,0,5"/>

            <Button Content="Open Graph Window"
                        Background="#00695c" Foreground="White"
                        FontWeight="Bold" Padding="10" Width="200"
                        Click="OpenGraph" Margin="0,0,0,5"/>

            <GroupBox Header="Critical Simulations" Margin="0,15,0,0">
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Margin="5">
                    <Button Content="Tachycardia" Width="100" Margin="5" Click="SimulateTachycardia"/>
                    <Button Content="Hypoxia" Width="100" Margin="5" Click="SimulateHypoxia"/>
                    <Button Content="Fever" Width="100" Margin="5" Click="SimulateFever"/>
                </StackPanel>
            </GroupBox>

        </StackPanel>



    </Grid>
</Window>
