<Window x:Class="Remotmonitor.PatientDetailWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:w="clr-namespace:Remotmonitor.Widgets"
        Title="Patientendetails"
        Height="700" Width="780"
        WindowStartupLocation="CenterOwner"
        Background="#0F0F0F"
        Foreground="#EAEAEA"
        FontFamily="Consolas">

    <Grid>
        <Grid.ColumnDefinitions>
            <!-- Alarmbalken links -->
            <ColumnDefinition Width="8"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Live-Alarmbalken -->
        <Border Grid.Column="0" Background="{Binding AlarmColor}"/>

        <Border Grid.Column="1" BorderBrush="#2A2A2A" BorderThickness="1" Padding="16" Margin="8">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <!-- Kopf -->
                    <RowDefinition Height="8"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Trenner -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Basisdaten + aktuelle Werte -->
                    <RowDefinition Height="16"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Überschrift Trends -->
                    <RowDefinition Height="*"/>
                    <!-- Sparklines -->
                    <RowDefinition Height="12"/>
                    <RowDefinition Height="Auto"/>
                    <!-- Close -->
                </Grid.RowDefinitions>

                <!-- Kopf -->
                <StackPanel Grid.Row="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Ellipse Width="14" Height="14" Fill="{Binding AlarmColor}" Stroke="#333" StrokeThickness="1"/>
                    <TextBlock Text="{Binding DisplayName}"
                               FontSize="22" FontWeight="Bold" Foreground="#67E8F9"
                               Margin="8,0,0,0"/>
                    <TextBlock Text="  •  " Foreground="#555" Margin="4,0"/>
                    <TextBlock Text="{Binding RoomBed}" Foreground="#CCCCCC"/>
                </StackPanel>

                <Rectangle Grid.Row="2" Height="2" Fill="#252525"/>

                <!-- Basisdaten + aktuelle Werte -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="2*"/>
                        <ColumnDefinition Width="3*"/>
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Identifikation" FontWeight="Bold" Foreground="#A1FFA1" Margin="0,0,0,8"/>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Patient-ID: " Foreground="#BDBDBD"/>
                            <TextBlock Text="{Binding PatientId}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Monitor-ID: " Foreground="#BDBDBD"/>
                            <TextBlock Text="{Binding MonitorId}" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Geschlecht, Alter: " Foreground="#BDBDBD"/>
                            <TextBlock>
                                <Run Text="{Binding Gender}"/><Run Text=", "/><Run Text="{Binding Age}"/><Run Text=" Jahre"/>
                            </TextBlock>
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,2">
                            <TextBlock Text="Zeit (lokal): " Foreground="#BDBDBD"/>
                            <TextBlock Text="{Binding TsLocal, Mode=OneWay, StringFormat={}{0:HH:mm:ss dd.MM.yyyy}}"/>
                        </StackPanel>
                    </StackPanel>

                    <StackPanel Grid.Column="1">
                        <TextBlock Text="Aktuelle Vitalparameter" FontWeight="Bold" Foreground="#A1FFA1" Margin="0,0,0,8"/>
                        <UniformGrid Columns="3" Rows="2">
                            <StackPanel Margin="6,4" HorizontalAlignment="Left">
                                <TextBlock Text="HR (bpm)" Foreground="Lime" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Hr}" FontSize="22" Foreground="Lime"/>
                            </StackPanel>
                            <StackPanel Margin="6,4" HorizontalAlignment="Left">
                                <TextBlock Text="SpO₂ (%)" Foreground="DeepSkyBlue" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Spo2}" FontSize="22" Foreground="DeepSkyBlue"/>
                            </StackPanel>
                            <StackPanel Margin="6,4" HorizontalAlignment="Left">
                                <TextBlock Text="RR (/min)" Foreground="Gold" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Rr}" FontSize="22" Foreground="Gold"/>
                            </StackPanel>
                            <StackPanel Margin="6,4" HorizontalAlignment="Left">
                                <TextBlock Text="Temp (°C)" Foreground="White" FontWeight="Bold"/>
                                <TextBlock Text="{Binding Temp}" FontSize="22" Foreground="White"/>
                            </StackPanel>
                            <StackPanel Margin="6,4" HorizontalAlignment="Left">
                                <TextBlock Text="BP (mmHg)" Foreground="Tomato" FontWeight="Bold"/>
                                <TextBlock>
                                    <Run Text="{Binding Sys}"/><Run Text="/"/><Run Text="{Binding Dia}"/>
                                </TextBlock>
                            </StackPanel>
                        </UniformGrid>
                    </StackPanel>
                </Grid>

                <!-- Überschrift Trends -->
                <TextBlock Grid.Row="6"
                           Text="Trends (letzte 60 s)"
                           FontWeight="Bold"
                           Foreground="#A1FFA1"
                           Margin="0,0,0,4"/>

                <!-- 5 Sparklines -->
                <StackPanel Grid.Row="7">
                    <w:Sparkline x:Name="HrSpark"
                                 Label="HR (bpm)"
                                 Min="40" Max="160"
                                 LineBrush="Lime"
                                 Height="54" Margin="0,2"/>
                    <w:Sparkline x:Name="SpO2Spark"
                                 Label="SpO₂ (%)"
                                 Min="80" Max="100"
                                 LineBrush="DeepSkyBlue"
                                 Height="54" Margin="0,2"/>
                    <w:Sparkline x:Name="RrSpark"
                                 Label="RR (/min)"
                                 Min="5" Max="40"
                                 LineBrush="Gold"
                                 Height="54" Margin="0,2"/>
                    <w:Sparkline x:Name="TempSpark"
                                 Label="Temp (°C)"
                                 Min="35" Max="40"
                                 LineBrush="White"
                                 Height="54" Margin="0,2"/>
                    <w:Sparkline x:Name="SysSpark"
                                 Label="Sys (mmHg)"
                                 Min="80" Max="180"
                                 LineBrush="Tomato"
                                 Height="54" Margin="0,2"/>
                </StackPanel>

                <!-- Fuß: Close -->
                <StackPanel Grid.Row="9" Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Width="120" Height="34" Content="Schließen" Click="Close_Click"
                            Background="#1F1F1F" Foreground="#EAEAEA" BorderBrush="#333"/>
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
