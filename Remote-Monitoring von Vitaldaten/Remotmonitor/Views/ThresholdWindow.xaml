<Window x:Class="Remotmonitor.Views.ThresholdWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Schwellenwerte einstellen"
        Width="720" Height="440"
        Background="#202020"
        Foreground="White"
        FontFamily="Consolas"
        FontSize="16"
        WindowStartupLocation="CenterOwner">

    <DockPanel Margin="10">

        <!-- Überschrift -->
        <TextBlock DockPanel.Dock="Top"
                   Text="Individuelle Schwellenwerte"
                   FontWeight="Bold"
                   FontSize="20"
                   Foreground="Cyan"
                   Margin="0,0,0,10"/>

        <!-- Buttons am unteren Rand -->
        <StackPanel DockPanel.Dock="Bottom"
                    Orientation="Horizontal"
                    HorizontalAlignment="Center"
                    Margin="0,10,0,0">
            <Button Content="OK"
                    Width="100"
                    Height="30"
                    Margin="8,0"
                    Click="OnOkClick"/>
            <Button Content="Abbrechen"
                    Width="120"
                    Height="30"
                    Margin="8,0"
                    Click="OnCancelClick"/>
        </StackPanel>

        <!-- Tabelle -->
        <DataGrid x:Name="ThresholdGrid"
                  AutoGenerateColumns="False"
                  CanUserAddRows="False"
                  CanUserResizeColumns="True"
                  IsReadOnly="False"
                  HeadersVisibility="Column"
                  GridLinesVisibility="All"
                  Background="#101010"
                  Foreground="White"
                  BorderBrush="#444"
                  RowBackground="#101010"
                  AlternatingRowBackground="#101010"
                  RowHeight="28"
                  Margin="0,0,0,10">
            <DataGrid.Resources>
                <!-- Header-Hintergrund & Schriftfarbe -->
                <Style TargetType="DataGridColumnHeader">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="BorderBrush" Value="#444"/>
                    <Setter Property="FontWeight" Value="Bold"/>
                    <Setter Property="FontSize" Value="16"/>
                    <Setter Property="Padding" Value="6,3"/>
                    <Setter Property="Foreground" Value="White"/>
                </Style>
                <!-- einzelne Spalten-Header einfärben -->
                <Style x:Key="WarningHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Foreground" Value="Orange"/>
                </Style>
                <Style x:Key="CriticalHeader" TargetType="DataGridColumnHeader" BasedOn="{StaticResource {x:Type DataGridColumnHeader}}">
                    <Setter Property="Foreground" Value="Red"/>
                </Style>
            </DataGrid.Resources>

            <DataGrid.Columns>
                <DataGridTextColumn Header="Parameter"
                                    Binding="{Binding Parameter}"
                                    IsReadOnly="True"
                                    Width="150" />

                <DataGridTextColumn Header="Warnung Min"
                                    Binding="{Binding WarningMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*">
                    <DataGridTextColumn.HeaderStyle>
                        <StaticResource ResourceKey="WarningHeader"/>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Warnung Max"
                                    Binding="{Binding WarningMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*">
                    <DataGridTextColumn.HeaderStyle>
                        <StaticResource ResourceKey="WarningHeader"/>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Kritisch Min"
                                    Binding="{Binding CriticalMin, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*">
                    <DataGridTextColumn.HeaderStyle>
                        <StaticResource ResourceKey="CriticalHeader"/>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>

                <DataGridTextColumn Header="Kritisch Max"
                                    Binding="{Binding CriticalMax, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                    Width="*">
                    <DataGridTextColumn.HeaderStyle>
                        <StaticResource ResourceKey="CriticalHeader"/>
                    </DataGridTextColumn.HeaderStyle>
                </DataGridTextColumn>
            </DataGrid.Columns>
        </DataGrid>
    </DockPanel>
</Window>
