<UserControl x:Class="Remotmonitor.Widgets.Sparkline"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Name="Root" Height="60" MinHeight="40">
    <Grid>
        <!-- Hintergrund & Achsen-Grid -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
                <RowDefinition/>
            </Grid.RowDefinitions>
            <Rectangle Fill="#0DFFFFFF"/>
            <Rectangle Grid.Row="1" Fill="#08FFFFFF"/>
            <Rectangle Grid.Row="2" Fill="#0DFFFFFF"/>
            <Rectangle Grid.Row="3" Fill="#08FFFFFF"/>
        </Grid>

        <!-- Linie -->
        <Canvas x:Name="PlotCanvas" Margin="0,2"/>
        <!-- aktueller Wert rechts -->
        <Border Background="#22000000" CornerRadius="3" Padding="4" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="2">
            <TextBlock Text="{Binding CurrentText, ElementName=Root}" FontSize="12" Foreground="White"/>
        </Border>
    </Grid>
</UserControl>
