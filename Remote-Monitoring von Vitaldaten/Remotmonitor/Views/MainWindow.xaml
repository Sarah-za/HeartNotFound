<Window x:Class="Remotmonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Remotmonitor.Models"
        Title="Remote Monitor"
        Background="Black"
        FontFamily="Consolas"
        FontSize="18"
        Foreground="Lime"
        Height="800" Width="1200"
        Loaded="Window_Loaded"
        UseLayoutRounding="True"
        SnapsToDevicePixels="True">

    <!-- ===== Styles ===== -->
    <Window.Resources>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="Gray"/>
        </Style>

        <!-- Zeilen-Stil mit Alarmfarben -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="Lime"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlarmColor.Color}" Value="{x:Static Colors.Red}">
                    <Setter Property="Background" Value="#440000"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmColor.Color}" Value="{x:Static Colors.Gold}">
                    <Setter Property="Background" Value="#443300"/>
                    <Setter Property="Foreground" Value="Gold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmColor.Color}" Value="{x:Static Colors.Lime}">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="Lime"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Karten-Stil -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111"/>
            <Setter Property="BorderBrush" Value="#33FF33"/>
            <Setter Property="BorderThickness" Value="2"/>
            <Setter Property="CornerRadius" Value="8"/>
            <Setter Property="Padding" Value="8"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="HorizontalAlignment" Value="Center"/>
            <Setter Property="VerticalAlignment" Value="Center"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="6" Color="#4400FF00" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Gruppen-Header: Zimmer + Anzahl -->
        <GroupStyle x:Key="RoomGroupStyle">
            <GroupStyle.HeaderTemplate>
                <DataTemplate>
                    <Border Background="#1E1E1E" BorderBrush="#333" BorderThickness="0,0,0,1" Padding="6" Margin="0,6,0,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Zimmer: " Foreground="Cyan" FontWeight="Bold"/>
                            <TextBlock Text="{Binding Name}" Foreground="White" Margin="6,0,12,0"/>
                            <TextBlock Text="( " Foreground="#999"/>
                            <TextBlock Text="{Binding ItemCount}" Foreground="#999"/>
                            <TextBlock Text=" Patient/en )" Foreground="#999"/>
                        </StackPanel>
                    </Border>
                </DataTemplate>
            </GroupStyle.HeaderTemplate>
            <GroupStyle.Panel>
                <ItemsPanelTemplate>
                    <VirtualizingStackPanel/>
                </ItemsPanelTemplate>
            </GroupStyle.Panel>
        </GroupStyle>

        <!-- ==== ComboBox dunkles Theme ==== -->
        <Style TargetType="ComboBox">
            <Setter Property="Background" Value="#111"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="BorderBrush" Value="#444"/>
            <Setter Property="Padding" Value="4,2"/>
            <Setter Property="FontSize" Value="16"/>
            <Setter Property="ScrollViewer.CanContentScroll" Value="True"/>
            <Setter Property="ScrollViewer.VerticalScrollBarVisibility" Value="Auto"/>
            <Setter Property="ItemContainerStyle">
                <Setter.Value>
                    <Style TargetType="ComboBoxItem">
                        <Setter Property="Background" Value="#111"/>
                        <Setter Property="Foreground" Value="White"/>
                        <Setter Property="FontSize" Value="16"/>
                        <Setter Property="HorizontalContentAlignment" Value="Left"/>
                        <Setter Property="Padding" Value="6,2"/>
                        <Style.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Background" Value="#0A84FF"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                            <Trigger Property="IsSelected" Value="True">
                                <Setter Property="Background" Value="#0055AA"/>
                                <Setter Property="Foreground" Value="White"/>
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ===== Layout ===== -->
    <Grid Margin="10">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="5"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- OBERHALB: Filter + Suche + Liste -->
        <Grid Grid.Row="0" Margin="0,0,0,6">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Filter-/Suchleiste -->
            <Grid Grid.Row="0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="10"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                </Grid.ColumnDefinitions>

                <!-- Zimmer-Filter -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Zimmer:" Margin="0,0,8,0" Foreground="#bbb"/>
                    <ComboBox Width="150"
                              ItemsSource="{Binding Rooms}"
                              SelectedItem="{Binding SelectedRoom, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
                </StackPanel>

                <!-- Suchfeld mit Lupe (ohne Button) -->
                <Grid Grid.Column="2" Width="320" Height="30">
                    <Border Background="#111" BorderBrush="#444" BorderThickness="1" CornerRadius="2"/>
                    <Grid Margin="6,0,6,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto"/>
                            <ColumnDefinition Width="*"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   FontFamily="Segoe MDL2 Assets"
                                   Text="&#xE721;"
                                   Foreground="#888"
                                   VerticalAlignment="Center"
                                   Margin="2,0,6,0"/>
                        <TextBox x:Name="SearchBox"
                                 Grid.Column="1"
                                 Background="Transparent"
                                 BorderThickness="0"
                                 Foreground="White"
                                 Padding="0,2"
                                 Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 KeyDown="SearchBox_KeyDown"
                                 ToolTip="Suche nach Patient-/Monitor-ID (Enter: ersten Treffer, Esc: löschen)"/>
                    </Grid>
                </Grid>
            </Grid>

            <!-- Liste -->
            <ListView x:Name="PatientList"
                      Grid.Row="1"
                      ItemsSource="{Binding VitalsView}"
                      SelectionMode="Extended"
                      SelectionChanged="PatientList_SelectionChanged"
                      Background="Black" Foreground="Lime" BorderBrush="Gray"
                      ScrollViewer.VerticalScrollBarVisibility="Auto"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling"
                      VirtualizingPanel.IsVirtualizingWhenGrouping="True"
                      VirtualizingPanel.ScrollUnit="Pixel"
                      ScrollViewer.CanContentScroll="True">
                <ListView.GroupStyle>
                    <StaticResource ResourceKey="RoomGroupStyle"/>
                </ListView.GroupStyle>
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Zimmer" DisplayMemberBinding="{Binding Room}" Width="90"/>
                        <GridViewColumn Header="Bett"   DisplayMemberBinding="{Binding Bed}"  Width="60"/>
                        <GridViewColumn Header="Patient" DisplayMemberBinding="{Binding DisplayName}" Width="210"/>
                        <GridViewColumn Header="Monitor" DisplayMemberBinding="{Binding MonitorId}" Width="90"/>
                        <GridViewColumn Header="HR" DisplayMemberBinding="{Binding Hr}" Width="60"/>
                        <GridViewColumn Header="SpO₂ (%)" DisplayMemberBinding="{Binding Spo2}" Width="80"/>
                        <GridViewColumn Header="RR" DisplayMemberBinding="{Binding Rr}" Width="60"/>
                        <GridViewColumn Header="Temp (°C)" DisplayMemberBinding="{Binding Temp}" Width="90"/>
                        <GridViewColumn Header="BP (mmHg)" DisplayMemberBinding="{Binding Bp}" Width="100"/>
                        <GridViewColumn Header="Zeit (lokal)" Width="200">
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="TsLocal" StringFormat="{}{0:HH:mm:ss dd.MM.yyyy}"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>
        </Grid>

        <!-- Splitter -->
        <GridSplitter Grid.Row="1"
                      HorizontalAlignment="Stretch"
                      VerticalAlignment="Stretch"
                      Background="#333"
                      ShowsPreview="True"/>

        <!-- Karten unten -->
        <ScrollViewer Grid.Row="2"
                      VerticalScrollBarVisibility="Auto"
                      HorizontalScrollBarVisibility="Disabled">
            <ItemsControl ItemsSource="{Binding SelectedTop8}" Margin="0">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.Columns,
                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:VitalSample}">
                        <Border Style="{StaticResource CardStyle}"
                        BorderBrush="{Binding AlarmColor}"
                        Cursor="Hand"
                        PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown">
                            <StackPanel HorizontalAlignment="Center"
                                        VerticalAlignment="Center"
                                        TextBlock.TextAlignment="Center">
                                <TextBlock Text="{Binding DisplayName}"
                                           FontSize="18"
                                           FontWeight="Bold"
                                           Foreground="Cyan"
                                           Margin="0,0,0,2"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding RoomBed}"
                                           Foreground="#bbb"
                                           FontSize="14"
                                           Margin="0,0,0,4"
                                           HorizontalAlignment="Center"/>
                                <TextBlock Text="{Binding MonitorId}"
                                           Opacity="0.7"
                                           FontSize="13"
                                           Margin="0,0,0,8"
                                           HorizontalAlignment="Center"/>
                                <UniformGrid Columns="5" HorizontalAlignment="Center" VerticalAlignment="Center">
                                    <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                        <TextBlock Text="HR" Foreground="Lime" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Hr}" Foreground="Lime" FontSize="20"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                        <TextBlock Text="SpO₂ (%)" Foreground="DeepSkyBlue" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Spo2}" Foreground="DeepSkyBlue" FontSize="20"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                        <TextBlock Text="RR" Foreground="Gold" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Rr}" Foreground="Gold" FontSize="20"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                        <TextBlock Text="Temp (°C)" Foreground="White" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Temp}" Foreground="White" FontSize="20"/>
                                    </StackPanel>
                                    <StackPanel Margin="4,0" HorizontalAlignment="Center">
                                        <TextBlock Text="BP (mmHg)" Foreground="Tomato" FontWeight="Bold" FontSize="13"/>
                                        <TextBlock Text="{Binding Bp}" Foreground="Tomato" FontSize="20"/>
                                    </StackPanel>
                                </UniformGrid>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</Window>