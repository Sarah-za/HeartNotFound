<Window x:Class="Remotmonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:m="clr-namespace:Remotmonitor.Models"
        Title="Remote Monitor"
        Background="Black"
        FontFamily="Consolas"
        FontSize="18"
        Foreground="Lime"
        Height="750" Width="1150"
        Loaded="Window_Loaded">

    <!-- ===== Styles ===== -->
    <Window.Resources>
        <Style TargetType="GridViewColumnHeader">
            <Setter Property="Foreground" Value="Cyan"/>
            <Setter Property="FontWeight" Value="Bold"/>
            <Setter Property="Background" Value="#222222"/>
            <Setter Property="BorderBrush" Value="Gray"/>
        </Style>

        <!-- 🔔 Zeilen-Stil mit Alarmfarben -->
        <Style TargetType="ListViewItem">
            <Setter Property="Background" Value="Black"/>
            <Setter Property="Foreground" Value="Lime"/>
            <Style.Triggers>
                <DataTrigger Binding="{Binding AlarmColor.Color}" Value="{x:Static Colors.Red}">
                    <Setter Property="Background" Value="#440000"/>
                    <Setter Property="Foreground" Value="White"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmColor.Color}" Value="{x:Static Colors.Gold}">
                    <Setter Property="Background" Value="#443300"/>
                    <Setter Property="Foreground" Value="Gold"/>
                </DataTrigger>
                <DataTrigger Binding="{Binding AlarmColor.Color}" Value="{x:Static Colors.Lime}">
                    <Setter Property="Background" Value="Black"/>
                    <Setter Property="Foreground" Value="Lime"/>
                </DataTrigger>
            </Style.Triggers>
        </Style>

        <!-- Karten-Stil -->
        <Style x:Key="CardStyle" TargetType="Border">
            <Setter Property="Background" Value="#111"/>
            <Setter Property="BorderBrush" Value="#333"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Padding" Value="12"/>
            <Setter Property="Margin" Value="8"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="10" Color="#5500FF00" ShadowDepth="0"/>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!-- ===== Layout ===== -->
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <!-- Titel -->
            <RowDefinition Height="Auto"/>
            <!-- Suche -->
            <RowDefinition Height="8"/>
            <!-- Abstand -->
            <RowDefinition Height="*"/>
            <!-- Liste + Kacheln -->
            <RowDefinition Height="Auto"/>
            <!-- Tipp -->
        </Grid.RowDefinitions>

        <!-- Titel -->
        <TextBlock Grid.Row="0"
                   Text="Remote Monitor (Mock-Daten, 1 Hz)"
                   FontSize="26" FontWeight="Bold" Foreground="Cyan"/>

        <!-- Suchleiste -->
        <Grid Grid.Row="1" Panel.ZIndex="10">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <TextBox x:Name="SearchBox"
                     Grid.Column="0"
                     Width="360" Height="32"
                     Padding="8,2"
                     Background="#111"
                     Foreground="White"
                     BorderBrush="#444"
                     Focusable="True"
                     IsTabStop="True"
                     Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                     KeyDown="SearchBox_KeyDown"
                     ToolTip="Suche nach Patient-ID oder Monitor-ID (Enter: ersten Treffer auswählen, Esc: löschen)"/>

            <Button Grid.Column="1" Margin="8,0,0,0" Padding="12,2"
                    Content="Suchen" Click="SearchSelectFirst_Click"/>
            <Button Grid.Column="2" Margin="8,0,0,0" Padding="12,2"
                    Content="Leeren (Esc)" Click="SearchClear_Click"/>

            <Border Grid.Column="3"/>
        </Grid>

        <Separator Grid.Row="2" Background="#333" Height="2"/>

        <!-- Liste + Kacheln -->
        <Grid Grid.Row="3">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <!-- Liste: an gefilterte View binden -->
            <ListView x:Name="PatientList"
                      Grid.Row="0"
                      ItemsSource="{Binding VitalsView}"
                      SelectionMode="Extended"
                      SelectionChanged="PatientList_SelectionChanged"
                      Background="Black" Foreground="Lime" BorderBrush="Gray">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Patient" DisplayMemberBinding="{Binding PatientId}" Width="160"/>
                        <GridViewColumn Header="Monitor" DisplayMemberBinding="{Binding MonitorId}" Width="120"/>
                        <GridViewColumn Header="HR" DisplayMemberBinding="{Binding Hr}" Width="80"/>
                        <GridViewColumn Header="SpO₂ (%)" DisplayMemberBinding="{Binding Spo2}" Width="100"/>
                        <GridViewColumn Header="RR" DisplayMemberBinding="{Binding Rr}" Width="80"/>
                        <GridViewColumn Header="Temp (°C)" DisplayMemberBinding="{Binding Temp}" Width="100"/>
                        <!-- Zeitspalte: jetzt LOKAL + formatiert -->
                        <GridViewColumn Header="Zeit (lokal)" Width="260">
                            <GridViewColumn.DisplayMemberBinding>
                                <Binding Path="TsLocal" StringFormat="{}{0:HH:mm:ss dd.MM.yyyy}"/>
                            </GridViewColumn.DisplayMemberBinding>
                        </GridViewColumn>
                    </GridView>
                </ListView.View>
            </ListView>

            <!-- Kacheln -->
            <ItemsControl Grid.Row="1"
                          ItemsSource="{Binding Selected}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Columns="{Binding DataContext.Columns,
                                   RelativeSource={RelativeSource AncestorType=ItemsControl}}"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>

                <ItemsControl.ItemTemplate>
                    <DataTemplate DataType="{x:Type m:VitalSample}">
                        <Border Style="{StaticResource CardStyle}"
                                BorderBrush="{Binding AlarmColor}"
                                BorderThickness="2">
                            <StackPanel>
                                <TextBlock Text="{Binding PatientId}" FontSize="22" Foreground="Cyan" FontWeight="Bold"/>
                                <TextBlock Text="{Binding MonitorId}" Opacity="0.7" Margin="0,-2,0,8"/>

                                <WrapPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="HR" Foreground="Lime" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Hr}" FontSize="28"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="SpO₂ (%)" Foreground="DeepSkyBlue" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Spo2}" FontSize="28"/>
                                    </StackPanel>
                                    <StackPanel Margin="0,0,16,0">
                                        <TextBlock Text="RR" Foreground="Gold" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Rr}" FontSize="28"/>
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="Temp (°C)" Foreground="White" FontWeight="Bold"/>
                                        <TextBlock Text="{Binding Temp}" FontSize="28"/>
                                    </StackPanel>
                                </WrapPanel>

                                <!-- Lokale Zeit auch in der Karte -->
                                <TextBlock Text="{Binding TsLocal, StringFormat='{}{0:HH:mm:ss dd.MM.yyyy}'}"
                                           Opacity="0.7" Margin="0,8,0,0"/>
                            </StackPanel>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </Grid>

        <TextBlock Grid.Row="4"
                   Text="Tipp: Strg/Shift für Mehrfachauswahl — Enter: ersten Treffer wählen — Esc: Suche löschen"
                   FontSize="14" Foreground="#888" HorizontalAlignment="Right"/>
    </Grid>
</Window>
