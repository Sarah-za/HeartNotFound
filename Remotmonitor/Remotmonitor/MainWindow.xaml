<Window x:Class="Remotmonitor.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Remote Monitor" Height="450" Width="800">
    <Grid Margin="12">
        <DockPanel>
            <TextBlock DockPanel.Dock="Top"
                       Text="Remote Monitor (Mock-Daten, 1 Hz)"
                       FontSize="18" FontWeight="Bold" Margin="0,0,0,8"/>
            <ListView ItemsSource="{Binding Vitals}">
                <ListView.View>
                    <GridView>
                        <GridViewColumn Header="Patient" DisplayMemberBinding="{Binding PatientId}" Width="120"/>
                        <GridViewColumn Header="Monitor" DisplayMemberBinding="{Binding MonitorId}" Width="120"/>
                        <GridViewColumn Header="HR" DisplayMemberBinding="{Binding Hr}" Width="80"/>
                        <GridViewColumn Header="SpO₂ (%)" DisplayMemberBinding="{Binding Spo2}" Width="80"/>
                        <GridViewColumn Header="RR" DisplayMemberBinding="{Binding Rr}" Width="80"/>
                        <GridViewColumn Header="Temp (°C)" DisplayMemberBinding="{Binding Temp}" Width="90"/>
                        <GridViewColumn Header="Zeit (UTC)" DisplayMemberBinding="{Binding Ts}" Width="180"/>
                    </GridView>
                </ListView.View>
            </ListView>
        </DockPanel>
    </Grid>
</Window>

