<Window x:Class="AdministrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdministrationApp"
        Title="Administration - Patientenverwaltung"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#40C4B4">

    <Window.Resources>
        <!-- Farben -->
        <Color x:Key="TurquoiseLightColor">#40C4B4</Color>
        <Color x:Key="TurquoiseDarkColor">#1FA89A</Color>
        <Color x:Key="AccentColor">#FF6FA7</Color>
        <Color x:Key="CardBgColor">#FFFFFF</Color>
        <Color x:Key="MutedText">#4B4B4B</Color>

        <SolidColorBrush x:Key="TurqDarkBrush" Color="{StaticResource TurquoiseDarkColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}"/>

        <!-- Button Style -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="PrimaryButtonBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource TurquoiseDarkColor}" Offset="0"/>
            <GradientStop Color="#149082" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentButtonBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF8FB0" Offset="0"/>
            <GradientStop Color="#FF6FA7" Offset="1"/>
        </LinearGradientBrush>

        <!-- TextBox Style -->
        <Style TargetType="TextBox" x:Key="RoundedTextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TurqDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <!-- Card Panel -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="6" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="880" Height="560"
                Background="#F2FFFF" CornerRadius="12" Padding="12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="AdministrationApp" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TurqDarkBrush}" DockPanel.Dock="Left"/>
                </DockPanel>

                <TabControl>

                    <!-- Patienten Tab -->
                    <TabItem Header="👨‍⚕️ Patienten">
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Eingabefelder -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="120"/>
                                        <ColumnDefinition Width="150"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" x:Name="txtVorname" Style="{StaticResource RoundedTextBox}" />
                                    <TextBox Grid.Column="1" x:Name="txtNachname" Style="{StaticResource RoundedTextBox}" />
                                    <ComboBox Grid.Column="2" x:Name="cbFreieMonitore" DisplayMemberPath="Modell" SelectedValuePath="MonitorId"/>
                                    <Button Grid.Column="3" Content="➕ Patient hinzufügen" Click="BtnAdd_Click" Style="{StaticResource PrimaryButton}" Background="{StaticResource PrimaryButtonBg}"/>
                                    <Button Grid.Column="4" Content="🗑 Patient löschen" Click="BtnDelete_Click" Style="{StaticResource PrimaryButton}" Background="{StaticResource AccentButtonBg}"/>
                                </Grid>

                                <!-- DataGrid Patienten -->
                                <DataGrid x:Name="dgPatienten" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Patient-ID" Binding="{Binding Id}" Width="Auto"/>
                                        <DataGridTextColumn Header="Vorname" Binding="{Binding Vorname}" Width="*"/>
                                        <DataGridTextColumn Header="Nachname" Binding="{Binding Nachname}" Width="*"/>
                                        <DataGridTextColumn Header="Monitor-ID" Binding="{Binding MonitorId}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>
                    <!-- Monitore Tab -->
                    <TabItem Header="🖥️ Monitore">
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Eingabefelder -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="220"/>
                                        <ColumnDefinition Width="180"/>
                                        <ColumnDefinition Width="160"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" x:Name="txtModell" Style="{StaticResource RoundedTextBox}" />
                                    <Button Grid.Column="1" Content="➕ Monitor hinzufügen" Click="BtnAddMonitor_Click" Style="{StaticResource PrimaryButton}" Background="{StaticResource PrimaryButtonBg}"/>
                                    <Button Grid.Column="2" Content="🗑 Monitor löschen" Click="BtnDeleteMonitor_Click" Style="{StaticResource PrimaryButton}" Background="{StaticResource AccentButtonBg}"/>
                                </Grid>
                                <!-- DataGrid Monitore -->
                                <DataGrid x:Name="dgMonitore" Grid.Row="1" AutoGenerateColumns="False" 
                                                    IsReadOnly="True" SelectionMode="Single">

                                    <!-- ✔ RowStyle ganz oben (richtige Position) -->
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="White" />

                                            <Style.Triggers>
                                                <!-- 🟢 Frei -->
                                                <DataTrigger Binding="{Binding Status}" Value="🟢 Frei">
                                                    <Setter Property="Background" Value="#B3FFD9"/>
                                                </DataTrigger>

                                                <!-- 🔴 Belegt -->
                                                <DataTrigger Binding="{Binding Status}" Value="🔴 Belegt">
                                                    <Setter Property="Background" Value="#FFB3B3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Monitor-ID" Binding="{Binding MonitorId}" Width="Auto"/>
                                        <DataGridTextColumn Header="Modell" Binding="{Binding Modell}" Width="*"/>
                                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/>

                                        <!-- Status-Spalte -->
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </Grid>
                        </Border>
                    </TabItem>



                </TabControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
