<Window x:Class="AdministrationApp.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:AdministrationApp"
        Title="Administration - Patientenverwaltung"
        Height="600" Width="900"
        WindowStartupLocation="CenterScreen"
        Background="#40C4B4">

    <Window.Resources>
        <!-- Farben -->
        <Color x:Key="TurquoiseLightColor">#40C4B4</Color>
        <Color x:Key="TurquoiseDarkColor">#1FA89A</Color>
        <Color x:Key="AccentColor">#FF6FA7</Color>
        <Color x:Key="CardBgColor">#FFFFFF</Color>
        <Color x:Key="MutedText">#4B4B4B</Color>

        <SolidColorBrush x:Key="TurqDarkBrush" Color="{StaticResource TurquoiseDarkColor}"/>
        <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
        <SolidColorBrush x:Key="CardBrush" Color="{StaticResource CardBgColor}"/>
        <SolidColorBrush x:Key="MutedTextBrush" Color="{StaticResource MutedText}"/>

        <!-- Button Style -->
        <Style TargetType="Button" x:Key="PrimaryButton">
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="8,6"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Cursor" Value="Hand"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border CornerRadius="8" Background="{TemplateBinding Background}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" Margin="10,2"/>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter Property="Opacity" Value="0.95"/>
                            </Trigger>
                            <Trigger Property="IsPressed" Value="True">
                                <Setter Property="Opacity" Value="0.85"/>
                            </Trigger>
                            <Trigger Property="IsEnabled" Value="False">
                                <Setter Property="Opacity" Value="0.5"/>
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <LinearGradientBrush x:Key="PrimaryButtonBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="{StaticResource TurquoiseDarkColor}" Offset="0"/>
            <GradientStop Color="#149082" Offset="1"/>
        </LinearGradientBrush>

        <LinearGradientBrush x:Key="AccentButtonBg" StartPoint="0,0" EndPoint="0,1">
            <GradientStop Color="#FF8FB0" Offset="0"/>
            <GradientStop Color="#FF6FA7" Offset="1"/>
        </LinearGradientBrush>

        <!-- TextBox Style -->
        <Style TargetType="TextBox" x:Key="RoundedTextBox">
            <Setter Property="Padding" Value="6"/>
            <Setter Property="BorderBrush" Value="#DDD"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Background" Value="White"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border Background="{TemplateBinding Background}" 
                                BorderBrush="{TemplateBinding BorderBrush}" 
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="6"
                                Padding="{TemplateBinding Padding}">
                            <ScrollViewer x:Name="PART_ContentHost"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- DataGrid Header -->
        <Style TargetType="DataGridColumnHeader">
            <Setter Property="Background" Value="{StaticResource TurqDarkBrush}"/>
            <Setter Property="Foreground" Value="White"/>
            <Setter Property="FontWeight" Value="SemiBold"/>
            <Setter Property="Padding" Value="6"/>
        </Style>

        <!-- Card Panel -->
        <Style x:Key="CardPanel" TargetType="Border">
            <Setter Property="CornerRadius" Value="10"/>
            <Setter Property="Background" Value="{StaticResource CardBrush}"/>
            <Setter Property="Padding" Value="10"/>
            <Setter Property="Margin" Value="4"/>
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect Color="#22000000" BlurRadius="6" ShadowDepth="2"/>
                </Setter.Value>
            </Setter>
        </Style>

    </Window.Resources>

    <Grid>
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Width="880" Height="560"
                Background="#F2FFFF" CornerRadius="12" Padding="12">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="Administration-App" FontSize="20" FontWeight="Bold" Foreground="{StaticResource TurqDarkBrush}" DockPanel.Dock="Left"/>
                </DockPanel>

                <TabControl>

                    <!-- Patienten Tab -->
                    <TabItem Header="👨‍⚕️ Patienten">
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Eingabefelder + Buttons -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="100"/>
                                        <!-- Vorname -->
                                        <ColumnDefinition Width="100"/>
                                        <!-- Nachname -->
                                        <ColumnDefinition Width="Auto"/>
                                        <!-- ComboBox + Buttons -->
                                    </Grid.ColumnDefinitions>

                                    <!-- Vorname -->
                                    <StackPanel Grid.Column="0">
                                        <TextBlock Text="Vorname" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                        <TextBox Grid.Column="0" x:Name="txtVorname" Width="90" Height="26" VerticalContentAlignment="Center"  />
                                    </StackPanel>

                                    <!-- Nachname -->
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="Nachname" FontSize="10" Foreground="Gray" Margin="0,0,0,2"/>
                                        <TextBox Grid.Column="1" x:Name="txtNachname" Width="90" Height="26" VerticalContentAlignment="Center"/>
                                    </StackPanel>

                                    <!-- ComboBox + alle Buttons im StackPanel nebeneinander -->
                                    <StackPanel Grid.Column="2" Orientation="Horizontal" HorizontalAlignment="Left" VerticalAlignment="Center" Margin="10,14,0,0">
                                        <!-- Freie Monitore -->
                                        <ComboBox x:Name="cbFreieMonitore" DisplayMemberPath="Modell" SelectedValuePath="Moid" 
                                                  Width="90" Height="26" FontSize="12" Margin="0,0,4,0"/>

                                        <!-- Buttons -->
                                        <Button Content="💻 Zuweisen" Click="BtnAssignMonitor_Click" 
                                                           Style="{StaticResource PrimaryButton}" Background="{StaticResource PrimaryButtonBg}" 
                                                           Width="90" Height="26" FontSize="12" Margin="0,0,4,0"/>
                                        <Button Content="➕ Hinzufügen" Click="BtnAdd_Click" 
                                                        Style="{StaticResource PrimaryButton}" Background="{StaticResource PrimaryButtonBg}" 
                                                        Width="90" Height="26" FontSize="12" Margin="0,0,4,0"/>
                                        <Button Content="🗑 Löschen" Click="BtnDelete_Click" 
                                                        Style="{StaticResource PrimaryButton}" Background="{StaticResource AccentButtonBg}" 
                                                        Width="90" Height="26" Margin="0,0,4,0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- DataGrid Patienten -->
                                <DataGrid x:Name="dgPatienten" Grid.Row="1" AutoGenerateColumns="False" IsReadOnly="True" SelectionMode="Single">
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="White"/>
                                            <Setter Property="Foreground" Value="Black"/>
                                            <Style.Triggers>
                                                <!-- ausgewählter Patient -->
                                                <Trigger Property="IsSelected" Value="True">
                                                    <Setter Property="Background" Value="#D3D3D3"/>
                                                    <!-- hellgrau -->
                                                    <Setter Property="Foreground" Value="Black"/>
                                                </Trigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Patient-ID" Binding="{Binding Id}" Width="Auto"/>
                                        <DataGridTextColumn Header="Vorname" Binding="{Binding Vorname}" Width="*"/>
                                        <DataGridTextColumn Header="Nachname" Binding="{Binding Nachname}" Width="*"/>
                                        <DataGridTextColumn Header="Zuordnung" Binding="{Binding MonitorName}" Width="2*"/>
                                    </DataGrid.Columns>
                                </DataGrid>
                            </Grid>
                        </Border>
                    </TabItem>



                    <!-- Monitore Tab -->
                    <TabItem Header="🖥️ Monitore">
                        <Border Style="{StaticResource CardPanel}">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="45"/>
                                    <RowDefinition Height="*"/>
                                </Grid.RowDefinitions>

                                <!-- Eingabefelder -->
                                <Grid Margin="0,0,0,10">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="130"/>
                                        <ColumnDefinition Width="115"/>
                                        <ColumnDefinition Width="100"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>

                                    <TextBox Grid.Column="0" x:Name="txtModell" VerticalContentAlignment="Center" Height="26" FontSize="12" Margin="0,0,4,0" />
                                    <Button Grid.Column="1" Content="➕ Hinzufügen" Click="BtnAddMonitor_Click" Style="{StaticResource PrimaryButton}" Background="{StaticResource PrimaryButtonBg}" Height="26" FontSize="12" Margin="0,0,4,0"/>
                                    <Button Grid.Column="2" Content="🗑 Löschen" Click="BtnDeleteMonitor_Click" Style="{StaticResource PrimaryButton}" Background="{StaticResource AccentButtonBg}" Height="26" FontSize="12" Margin="0,0,4,0"/>
                                </Grid>
                                <!-- DataGrid Monitore -->
                                <DataGrid x:Name="dgMonitore" Grid.Row="1" AutoGenerateColumns="False" 
                                                    IsReadOnly="True" SelectionMode="Single">

                                    <!-- ✔ RowStyle ganz oben (richtige Position) -->
                                    <DataGrid.RowStyle>
                                        <Style TargetType="DataGridRow">
                                            <Setter Property="Background" Value="White" />

                                            <Style.Triggers>
                                                <!-- 🟢 Frei -->
                                                <DataTrigger Binding="{Binding Status}" Value="🟢 Frei">
                                                    <Setter Property="Background" Value="#B3FFD9"/>
                                                </DataTrigger>

                                                <!-- 🔴 Belegt -->
                                                <DataTrigger Binding="{Binding Status}" Value="🔴 Belegt">
                                                    <Setter Property="Background" Value="#FFB3B3"/>
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </DataGrid.RowStyle>

                                    <DataGrid.Columns>
                                        <DataGridTextColumn Header="Monitor-ID" Binding="{Binding Moid}" Width="Auto"/>
                                        <DataGridTextColumn Header="Modell" Binding="{Binding Modell}" Width="*"/>
                                        <DataGridTextColumn Header="Patient" Binding="{Binding PatientName}" Width="*"/>

                                        <!-- Status-Spalte -->
                                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="Auto"/>
                                    </DataGrid.Columns>
                                </DataGrid>

                            </Grid>
                        </Border>
                    </TabItem>



                </TabControl>
            </StackPanel>
        </Border>
    </Grid>
</Window>
